# Verbose AI - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or real secrets to git.

# Neon Postgres Database Connection (with pgvector)
DATABASE_URL=postgresql://neondb_owner:<YOUR_PASSWORD>@<YOUR_ENDPOINT>.neon.tech/neondb?sslmode=require

# AI Cascade Multi-Provider Keys
# Tier 1: Groq LPUs (Ultra-low latency inference, Qwen & GPT-OSS)
GROQ_API_KEY=your_groq_api_key_here

# Tier 2: OpenRouter (Frontier LLMs: Llama 3.3 70B, Mixtral)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tier 3: Google AI Studio (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
